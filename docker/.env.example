# Compose project
COMPOSE_PROJECT_NAME=pudim

# MongoDB
MONGODB_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me-root
MONGO_DB=pudim
MONGO_APP_USERNAME=pudim_app
MONGO_APP_PASSWORD=change-me-app
MONGO_BACKUP_USERNAME=pudim_backup
MONGO_BACKUP_PASSWORD=change-me-backup

# Valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=change-me-valkey

# Bot
BOT_TOKEN=
NODE_ENV=production

# Applications connect to MongoDB/Valkey through the private Docker network.
MONGODB_URI=mongodb://pudim_app:change-me-app@mongodb:27017/pudim?authSource=pudim
VALKEY_URL=redis://:change-me-valkey@valkey:6379

# MongoDB backups
MONGODB_BACKUP_ENABLED=true
MONGODB_BACKUP_INTERVAL=1h
MONGODB_BACKUP_RETENTION_DAYS=7
MONGODB_BACKUP_DIR=/data/backups
MONGODB_BACKUP_NAME=pudim
MONGODB_BACKUP_MAX_UPLOAD_BYTES=26214400
MONGODB_BACKUP_WEBHOOK_URL=
MONGODB_BACKUP_ENCRYPTION_KEY=

# Image tags
PUDIM_BOT_IMAGE=ghcr.io/projectpudim/pudim-bot:latest
PUDIM_BACKUP_IMAGE=ghcr.io/projectpudim/pudim-mongodb-backup:latest